---
import { Icon } from "astro-icon/components";
import Layout from "../layouts/Layout.astro";
import WindowLayout from "../layouts/WindowLayout.astro";

const projects = [
  {
    title: "SciBorgs Website",
    desc: "Building website for Bronx Science's FRC Team, the Sciborgs, using Astro, React, and Sass.",
    href: "https://github.com/SciBorgs/SciborgsWebsite/",
    date: "December 2025 - Now",
  },
  {
    title: "Apeiro - Into The Deep",
    desc: "Wrote autonomous and teleop code for Bronx Science's FTC Team, Apeiro.",
    href: "https://github.com/BxSciFTC/IntoTheDeep-24",
    date: "September 2024 - March 2025",
  },
  {
    title: "FloorIsLava",
    desc: "A Minecraft plugin where lava gradually rises over time, forcing people to be the last one to survive.",
    href: "https://github.com/EpicCarlito/FloorIsLava",
    date: "July - August 2024",
  },
  {
    title: "EmailChecker",
    desc: "A simple way to check if an email exists! Built for email verification in a discord bot.",
    href: "https://github.com/EpicCarlito/EmailChecker",
    date: "July - August 2023",
  },
];
---
<title>Projects | EpicCarlito</title>

<Layout>
  <div class="innerContainer">
    <WindowLayout>
      <div class="projects">
        {
          projects.map((project, i) => (
            <a
              href={project.href}
              data-tap={project?.href ? 1.1 : 1}
              class={`projectContainer dropShadow ${project?.href ? "miniScaleUp" : ""}`}
            >
              <h1>{project.title}</h1>
              <p>{project.desc}</p>
              <b>From: {project.date}</b>
              {project?.href && (
                <div class="sourceContainer">
                  <Icon name="mdi:github" />
                  <p>source on github</p>
                </div>
              )}
            </a>
          ))
        }
      </div>
    </WindowLayout>
  </div>
</Layout>

<style>
  .projects {
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
  }

  .projectContainer {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.5rem;
    background-color: var(--inner-bg);
    border: 1px solid white;
    border-radius: 0.5rem;
    cursor: pointer;

    h1,
    p {
      margin: 0;
      font-family: var(--font-sen);
    }

    &:hover {
      border-color: blue;
    }
  }

  .sourceContainer {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 0.25rem;
  }

  [data-icon] {
    font-size: var(--text-3xl);
  }

  @media (width >= 48rem) {
    .projects {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
